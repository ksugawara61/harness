{
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm view:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm --filter:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Bash(gh run view:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(ls:*)"
    ],
    "defaultMode": "plan",
    "deny": [
      "Bash(rm:*)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "statusLine": {
    "command": "jq -r '\"[\\(.model.display_name)] \\(.context_window.used_percentage // 0)% context\"'",
    "type": "command"
  }
}
