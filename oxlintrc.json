{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": ["./dist/plugin.js"],
  "plugins": [
    "typescript",
    "unicorn",
    "react",
    "jsx-a11y",
    "import",
    "promise",
    "oxc"
  ],
  "rules": {
    "array-callback-return": "error",
    "code-lint/cognitive-complexity": "error",
    "code-lint/graphql-no-duplicate-argument-names": "error",
    "code-lint/graphql-no-duplicate-enum-value-names": "error",
    "code-lint/graphql-no-duplicate-field-definition-names": "error",
    "code-lint/graphql-no-duplicate-fields": "error",
    "code-lint/graphql-no-duplicate-input-field-names": "error",
    "code-lint/graphql-no-duplicate-operation-name": "error",
    "code-lint/graphql-no-duplicate-variable-names": "error",
    "code-lint/graphql-use-deprecated-date": "error",
    "code-lint/graphql-use-deprecated-reason": "error",
    "code-lint/graphql-use-lone-anonymous-operation": "error",
    "code-lint/graphql-use-lone-executable-definition": "error",
    "code-lint/graphql-use-named-operations": "error",
    "code-lint/no-dynamic-namespace-import-access": "warn",
    "code-lint/no-flat-map-identity": "warn",
    "code-lint/no-implicit-any-let": "error",
    "code-lint/no-misplaced-list-elements": "error",
    "code-lint/no-string-case-mismatch": "error",
    "code-lint/no-suspicious-semicolon-in-jsx": "warn",
    "code-lint/no-svg-without-title": "error",
    "code-lint/no-this-in-static": "warn",
    "code-lint/no-unsafe-iframe-sandbox": "error",
    "code-lint/no-unused-template-literal": "error",
    "code-lint/no-useless-continue": "warn",
    "code-lint/no-useless-string-raw": "warn",
    "code-lint/no-useless-undefined-initialization": "warn",
    "code-lint/no-void-type-return": "error",
    "code-lint/no-xor-as-exponentiation": "warn",
    "code-lint/sort-jsx-attributes": "error",
    "code-lint/sort-keys": "error",
    "code-lint/use-flat-math-min-max": "warn",
    "code-lint/use-parse-int-radix": "warn",
    "code-lint/use-semantic-elements": "error",
    "code-lint/use-simple-number-keys": "warn",
    "constructor-super": "error",
    "default-case-last": "warn",
    "default-param-last": "error",
    "dot-notation": "warn",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "for-direction": "error",
    "getter-return": "error",
    "import/no-default-export": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-ambiguous-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/lang": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": [
      "error",
      {
        "ignoreNonDOM": true
      }
    ],
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "nextjs/google-font-display": "warn",
    "no-array-constructor": "warn",
    "no-async-promise-executor": "error",
    "no-case-declarations": "error",
    "no-class-assign": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-const-assign": "error",
    "no-constant-condition": "error",
    "no-constructor-return": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "no-dupe-class-members": "error",
    "no-dupe-else-if": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-else-return": "error",
    "no-empty-character-class": "error",
    "no-empty-pattern": "error",
    "no-eval": "error",
    "no-ex-assign": "warn",
    "no-extra-boolean-cast": "warn",
    "no-extra-label": "warn",
    "no-fallthrough": "error",
    "no-func-assign": "error",
    "no-global-assign": "error",
    "no-implied-eval": "error",
    "no-import-assign": "error",
    "no-inner-declarations": "error",
    "no-irregular-whitespace": "warn",
    "no-label-var": "error",
    "no-labels": "warn",
    "no-lone-blocks": "warn",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-obj-calls": "error",
    "no-param-reassign": "error",
    "no-proto": "warn",
    "no-prototype-builtins": "warn",
    "no-redeclare": "error",
    "no-regex-spaces": "warn",
    "no-script-url": "error",
    "no-self-assign": "error",
    "no-self-compare": "error",
    "no-sequences": "warn",
    "no-setter-return": "error",
    "no-shadow-restricted-names": "error",
    "no-sparse-arrays": "error",
    "no-template-curly-in-string": "warn",
    "no-this-before-super": "error",
    "no-unneeded-ternary": "error",
    "no-unreachable": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-labels": "warn",
    "no-unused-private-class-members": "warn",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "varsIgnorePattern": "^_"
      }
    ],
    "no-use-before-define": [
      "error",
      {
        "classes": false,
        "functions": false,
        "typedefs": false,
        "variables": false
      }
    ],
    "no-useless-backreference": "warn",
    "no-useless-catch": "warn",
    "no-useless-constructor": "warn",
    "no-useless-escape": "warn",
    "no-useless-rename": "warn",
    "no-with": "error",
    "one-var": ["error", "never"],
    "oxc/approx-constant": "warn",
    "oxc/bad-min-max-func": "error",
    "oxc/misrefactored-assign-op": "error",
    "oxc/no-accumulating-spread": "warn",
    "oxc/no-const-enum": "warn",
    "prefer-arrow-callback": "error",
    "prefer-const": "warn",
    "prefer-exponentiation-operator": "warn",
    "prefer-numeric-literals": "warn",
    "prefer-regex-literals": "warn",
    "prefer-rest-params": "warn",
    "prefer-template": "warn",
    "promise/no-nesting": "error",
    "promise/no-return-in-finally": "warn",
    "react/button-has-type": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-target-blank": "error",
    "react/jsx-no-useless-fragment": [
      "warn",
      {
        "allowExpressions": true
      }
    ],
    "react/rules-of-hooks": "error",
    "react/self-closing-comp": "error",
    "react/void-dom-elements-no-children": "error",
    "require-yield": "error",
    "typescript/adjacent-overload-signatures": "warn",
    "typescript/ban-ts-comment": "warn",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-exports": "warn",
    "typescript/consistent-type-imports": [
      "warn",
      {
        "disallowTypeAnnotations": false,
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-duplicate-enum-values": "warn",
    "typescript/no-empty-interface": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extra-non-null-assertion": "warn",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "name": [
              "after",
              "afterEach",
              "before",
              "beforeEach",
              "describe",
              "it",
              "suite",
              "test"
            ],
            "package": "node:test"
          }
        ]
      }
    ],
    "typescript/no-inferrable-types": "error",
    "typescript/no-invalid-void-type": "warn",
    "typescript/no-misused-new": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-this-alias": "warn",
    "typescript/no-unnecessary-type-constraint": "warn",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "warn",
    "typescript/no-useless-empty-export": "warn",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-enum-initializers": "error",
    "typescript/prefer-function-type": "warn",
    "typescript/prefer-literal-enum-member": "warn",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/prefer-optional-chain": "warn",
    "unicorn/new-for-builtins": "error",
    "unicorn/no-document-cookie": "warn",
    "unicorn/no-empty-file": "error",
    "unicorn/no-instanceof-array": "warn",
    "unicorn/no-static-only-class": "warn",
    "unicorn/no-thenable": "error",
    "unicorn/no-useless-switch-case": "warn",
    "unicorn/prefer-array-flat-map": "warn",
    "unicorn/prefer-array-index-of": "warn",
    "unicorn/prefer-date-now": "warn",
    "unicorn/prefer-dom-node-text-content": "warn",
    "unicorn/prefer-math-min-max": "warn",
    "unicorn/prefer-modern-math-apis": "warn",
    "unicorn/prefer-node-protocol": "warn",
    "unicorn/prefer-number-properties": "error",
    "use-isnan": "error",
    "valid-typeof": "error"
  }
}
