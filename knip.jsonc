{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": [],
    },
    "packages/code-lint": {
      "entry": ["src/plugin.ts", "src/bin/*.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/docs-lint": {
      "entry": ["src/index.ts", "src/char-limit/count.ts", "src/bin/*.ts"],
      "project": ["src/**/*.ts"],
      // profiles/textlint/*.json の rules から textlint が名前で読み込むため、import されない
      "ignoreDependencies": [
        "@textlint-ja/textlint-rule-preset-ai-writing",
        "textlint-rule-preset-ai-words-ja",
        "textlint-rule-preset-ja-technical-writing",
      ],
    },
    "packages/spec": {
      "entry": [
        "src/index.ts",
        "src/reporter.ts",
        "src/vitest.ts",
        "src/bin/*.ts",
      ],
      "project": ["src/**/*.ts"],
    },
  },
}
