{
  "devDependencies": {
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "harness",
  "packageManager": "pnpm@11.1.2",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "pnpm build && oxlint && pnpm lint:json && pnpm lint:docs && pnpm lint:shell",
    "lint:docs": "node packages/docs-lint/src/bin/docs-lint.ts",
    "lint:json": "node packages/code-lint/src/bin/sort-json-keys.ts 'package.json' '.oxlintrc.json' '.claude-plugin/*.json' 'claude/settings.json' 'plugins/*/.claude-plugin/*.json' 'plugins/*/hooks/*.json' 'packages/*/oxlintrc.json' 'packages/*/oxfmtrc.json' 'packages/*/profiles/**/*.json'",
    "lint:shell": "bash -n scripts/*.sh plugins/*/hooks/*.sh",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "bash scripts/install.test.sh",
    "typecheck": "pnpm -r typecheck"
  }
}
