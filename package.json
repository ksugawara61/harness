{
  "bin": {
    "code-lint-graphql": "./dist/bin/lint-graphql.js",
    "code-lint-sort-json-keys": "./dist/bin/sort-json-keys.js"
  },
  "bugs": "https://github.com/ksugawara61/code-lint/issues",
  "dependencies": {
    "@oxlint/plugins": "^1.87.0",
    "aria-query": "^5.3.2",
    "graphql": "^16.14.1"
  },
  "description": "Shared oxlint and oxfmt config with a JS plugin that ports Biome rules, plus GraphQL and JSON key-order checks",
  "devDependencies": {
    "@types/aria-query": "^5.0.4",
    "@types/node": "25.2.0",
    "knip": "^6.12.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./oxfmtrc.json": "./oxfmtrc.json",
    "./oxlintrc.json": "./oxlintrc.json",
    "./package.json": "./package.json",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "oxfmtrc.json",
    "oxlintrc.json"
  ],
  "homepage": "https://github.com/ksugawara61/code-lint#readme",
  "keywords": [
    "biome",
    "graphql",
    "lint",
    "oxfmt",
    "oxlint",
    "oxlint-plugin"
  ],
  "license": "MIT",
  "name": "@ksugawara61/code-lint",
  "packageManager": "pnpm@11.1.2",
  "peerDependencies": {
    "oxlint": "^1.87.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksugawara61/code-lint.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt -c oxfmtrc.json",
    "format:check": "oxfmt -c oxfmtrc.json --check",
    "knip": "knip",
    "lint": "pnpm build && oxlint && pnpm lint:json",
    "lint:json": "node src/bin/sort-json-keys.ts oxlintrc.json oxfmtrc.json .oxlintrc.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
